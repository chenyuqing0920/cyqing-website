DATABASE_URL=file:../data/space.db
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
PORT=3070
NODE_ENV=development
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3070
COOKIE_SECURE=false
TRUST_PROXY=0
# Tools (password-free, proxied same-origin at {BASE_PATH}/files and {BASE_PATH}/douyin)
FILE_DROP_URL=http://127.0.0.1:7864
DOUYIN_URL=http://127.0.0.1:7863
FILE_DROP_MAX_MB=2048
TOOL_WRITE_LIMIT_PER_MIN=60
TOOL_READ_LIMIT_PER_MIN=600
# TOOLS_USE_LEGACY=1 + LEGACY_BASE_URL=https://old.example  -> reuse the old front proxy
BASE_PATH=

# Machine / AI write access (optional). Bearer token for full-site admin writes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MACHINE_API_KEY=
# MACHINE_WRITE_LIMIT_PER_MIN=120
