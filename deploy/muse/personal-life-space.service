[Unit]
Description=Personal life space (isolated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 实际运行用户为 root（本环境不存在 hatch 用户）；HOME 指向工作区所在位置。
User=root
Environment=HOME=/home/hatch
WorkingDirectory=/home/hatch/workspace/projects/personal-life-space
ExecStart=/bin/bash /home/hatch/workspace/projects/personal-life-space/deploy/muse/run.sh
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
