<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a0a14">
<meta name="description" content="陈玉庆的个人博客 — AI 应用开发、RAG、开源小工具与折腾记录。">
<title>陈玉庆 · 个人博客</title>
<link rel="icon" href="/static/icon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500;700;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#faf9f6; --ink:#1b1815; --ink2:#45403a; --muted:#8a8177;
    --line:#e6e1d8; --accent:#b3402a; --accent-soft:#f3e3de;
    --card:#fff; --serif:"Noto Serif SC","Songti SC","STSong",serif;
    --latin:"Newsreader",Georgia,serif;
    --sans:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  ::selection{background:var(--accent);color:#fff}
  a{color:inherit}
  .progress{position:fixed;top:0;left:0;height:2px;background:var(--accent);width:0;z-index:60}
  /* ---------- nav ---------- */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;
    background:rgba(250,249,246,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid transparent;transition:border-color .3s}
  nav.scrolled{border-bottom-color:var(--line)}
  .nav-in{max-width:1060px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;gap:28px}
  .brand{font-family:var(--serif);font-weight:900;font-size:19px;letter-spacing:.02em;text-decoration:none;display:flex;align-items:baseline;gap:10px}
  .brand .en{font-family:var(--latin);font-weight:400;font-size:12px;letter-spacing:.28em;color:var(--muted);text-transform:uppercase}
  .brand .dot{color:var(--accent)}
  .nav-links{margin-left:auto;display:flex;gap:26px;font-size:14px}
  .nav-links a{text-decoration:none;color:var(--ink2);position:relative;padding:4px 0}
  .nav-links a::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:0;background:var(--accent);transition:width .25s}
  .nav-links a:hover{color:var(--ink)}
  .nav-links a:hover::after{width:100%}
  @media(max-width:640px){.nav-links{gap:16px;font-size:13px}.brand .en{display:none}}
  main{max-width:1060px;margin:0 auto;padding:0 24px}
  /* ---------- hero ---------- */
  .hero{padding:158px 0 64px;border-bottom:1px solid var(--line)}
  .kicker{font-family:var(--latin);font-size:13px;letter-spacing:.32em;text-transform:uppercase;color:var(--accent);margin:0 0 22px}
  .hero h1{font-family:var(--serif);font-weight:900;font-size:clamp(40px,7vw,68px);line-height:1.16;letter-spacing:.01em;margin:0 0 24px}
  .hero h1 .thin{display:block;font-size:.52em;font-weight:500;color:var(--ink2);margin-top:14px;letter-spacing:.04em}
  .hero .sub{max-width:620px;font-size:16px;line-height:1.85;color:var(--ink2);margin:0 0 34px}
  .hero-meta{display:flex;flex-wrap:wrap;gap:12px 34px;font-size:13px;color:var(--muted)}
  .hero-meta b{color:var(--ink);font-weight:600}
  /* ---------- sections ---------- */
  section{padding:64px 0;border-bottom:1px solid var(--line)}
  .sec-head{display:flex;align-items:baseline;gap:16px;margin-bottom:36px}
  .sec-head h2{font-family:var(--serif);font-weight:900;font-size:27px;margin:0}
  .sec-head .en{font-family:var(--latin);font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--muted)}
  .sec-head .rule{flex:1;height:1px;background:var(--line);align-self:center}
  /* ---------- post list ---------- */
  .post{display:grid;grid-template-columns:118px 1fr auto;gap:8px 26px;padding:26px 10px;text-decoration:none;
    border-top:1px solid var(--line);transition:background .2s;align-items:baseline}
  .post:first-of-type{border-top:none}
  .post:hover{background:#fff}
  .post .date{font-family:var(--latin);font-size:14px;color:var(--muted);letter-spacing:.04em;white-space:nowrap}
  .post .tag{display:inline-block;font-size:11px;letter-spacing:.14em;color:var(--accent);
    border:1px solid var(--accent-soft);background:#fdf3f0;border-radius:999px;padding:2px 9px;margin-bottom:9px}
  .post h3{font-family:var(--serif);font-weight:700;font-size:21px;line-height:1.45;margin:0 0 8px}
  .post:hover h3{color:var(--accent)}
  .post p{margin:0;font-size:14px;line-height:1.75;color:var(--ink2);max-width:640px}
  .post .mins{font-size:12px;color:var(--muted);white-space:nowrap}
  @media(max-width:640px){.post{grid-template-columns:1fr}.post .mins{display:none}}
  /* ---------- projects & tools ---------- */
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  @media(max-width:860px){.cards{grid-template-columns:1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;text-decoration:none;
    display:flex;flex-direction:column;gap:9px;transition:transform .2s,box-shadow .2s}
  .card:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(27,24,21,.08)}
  .card .no{font-family:var(--latin);font-size:12px;letter-spacing:.26em;color:var(--muted)}
  .card h3{font-family:var(--serif);font-size:18px;font-weight:700;margin:0;line-height:1.5}
  .card p{margin:0;font-size:13.5px;line-height:1.75;color:var(--ink2);flex:1}
  .card .go{font-size:13px;color:var(--accent);font-weight:600}
  .card.off{opacity:.55;pointer-events:none}
  .card .go.soon{color:var(--muted)}
  /* ---------- about ---------- */
  .about{display:grid;grid-template-columns:200px 1fr;gap:40px}
  @media(max-width:640px){.about{grid-template-columns:1fr}}
  .avatar{width:168px;height:168px;border-radius:50%;background:linear-gradient(135deg,#2b2620,#57493a);
    color:#f5efe4;display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-size:56px;font-weight:900;letter-spacing:.05em}
  .about p{font-size:15px;line-height:1.95;color:var(--ink2);margin:0 0 14px}
  .about p b{color:var(--ink)}
  .about .links{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}
  .about .links a{font-size:13px;text-decoration:none;border:1px solid var(--line);background:#fff;
    padding:8px 16px;border-radius:999px;transition:border-color .2s}
  .about .links a:hover{border-color:var(--accent);color:var(--accent)}
  /* ---------- article ---------- */
  .article{max-width:720px;margin:0 auto;padding:130px 0 80px}
  .article .back{font-size:13.5px;color:var(--muted);text-decoration:none}
  .article .back:hover{color:var(--accent)}
  .article .tag{display:inline-block;font-size:11px;letter-spacing:.14em;color:var(--accent);
    border:1px solid var(--accent-soft);background:#fdf3f0;border-radius:999px;padding:2px 9px;margin:26px 0 14px}
  .article h1{font-family:var(--serif);font-weight:900;font-size:clamp(28px,5vw,40px);line-height:1.35;margin:0 0 16px}
  .article .meta{font-size:13px;color:var(--muted);padding-bottom:28px;border-bottom:1px solid var(--line);margin-bottom:34px}
  .article .body p{font-size:16.5px;line-height:2.0;color:#2c2823;margin:0 0 22px}
  .article .body h4{font-family:var(--serif);font-size:20px;font-weight:700;margin:36px 0 14px}
  .article .body code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.88em;
    background:#f0ece4;border-radius:5px;padding:1px 6px}
  .article .body pre{background:#211d18;color:#e9e2d4;border-radius:12px;padding:18px 20px;overflow-x:auto;margin:0 0 22px}
  .article .body pre code{background:none;padding:0;color:inherit;font-size:13.5px;line-height:1.7}
  .article .end{margin-top:44px;padding-top:22px;border-top:1px solid var(--line);font-size:13px;color:var(--muted)}
  /* ---------- footer / misc ---------- */
  footer{max-width:1060px;margin:0 auto;padding:36px 24px 52px;display:flex;flex-wrap:wrap;gap:10px 26px;
    font-size:12.5px;color:var(--muted);align-items:baseline}
  footer .fbrand{font-family:var(--serif);font-weight:700;color:var(--ink2);font-size:14px}
  footer .sp{flex:1}
  .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}
  [hidden]{display:none!important}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 20px}
.chip{border:1px solid #d8d2c4;background:transparent;color:#44403c;padding:6px 14px;border-radius:999px;cursor:pointer;font-size:13.5px;font-family:inherit;transition:all .15s}
.chip:hover{border-color:#a8a29e}
.chip.on{background:#1c1917;color:#faf9f6;border-color:#1c1917}
.prompt-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.pcard{border:1px solid #e7e2d6;border-radius:10px;padding:16px 18px;background:#fffdf9;display:flex;flex-direction:column;gap:8px}
.pcard h3{font-size:16px;margin:0}
.pcard .pdesc{color:#78716c;font-size:13.5px;margin:0;line-height:1.55}
.pcard pre{white-space:pre-wrap;word-break:break-word;background:#f5f2ea;border-radius:8px;padding:10px 12px;font-size:13px;line-height:1.6;margin:4px 0 0;max-height:180px;overflow:auto}
.pcard .prow{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:6px}
.pcard .psrc{color:#a8a29e;font-size:12px}
.copy-btn{border:1px solid #d8d2c4;background:#faf9f6;padding:5px 14px;border-radius:999px;cursor:pointer;font-size:13px;font-family:inherit}
.copy-btn:hover{background:#1c1917;color:#faf9f6;border-color:#1c1917}
/* ================= 活力炫彩主题（2026-10-23） ================= */
:root{
  --paper:#0a0a14; --ink:#f4f2ff; --ink2:#c9c5e3; --muted:#8f8bb0;
  --line:rgba(255,255,255,.13); --accent:#a78bfa; --accent-soft:rgba(167,139,250,.20);
  --card:rgba(255,255,255,.045);
}
body{background:#0a0a14}
body::before{content:"";position:fixed;inset:-18%;z-index:-2;pointer-events:none;
  background:
    radial-gradient(560px 420px at 12% 8%, rgba(124,58,237,.42), transparent 65%),
    radial-gradient(640px 480px at 88% 16%, rgba(219,39,119,.30), transparent 65%),
    radial-gradient(700px 560px at 55% 92%, rgba(13,148,136,.30), transparent 65%),
    radial-gradient(420px 340px at 78% 68%, rgba(37,99,235,.26), transparent 65%);
  filter:blur(28px);animation:aurora 26s ease-in-out infinite alternate}
@keyframes aurora{
  from{transform:translate3d(-2%,-1%,0) scale(1) rotate(0deg)}
  to{transform:translate3d(2.5%,2%,0) scale(1.09) rotate(2deg)}}
body::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.5;
  background-image:
    radial-gradient(1.5px 1.5px at 22px 34px, rgba(255,255,255,.85), transparent 60%),
    radial-gradient(1px 1px at 130px 90px, rgba(255,255,255,.6), transparent 60%),
    radial-gradient(1.2px 1.2px at 240px 40px, rgba(255,255,255,.75), transparent 60%),
    radial-gradient(1px 1px at 320px 130px, rgba(255,255,255,.5), transparent 60%);
  background-size:360px 170px}
::selection{background:#7c3aed;color:#fff}
.progress{background:linear-gradient(90deg,#7c3aed,#db2777,#0d9488)}
nav{background:rgba(10,10,20,.66)}
nav.scrolled{border-bottom-color:var(--line)}
.nav-links a::after{background:linear-gradient(90deg,#a78bfa,#f472b6)}
.brand .dot{background:linear-gradient(120deg,#a78bfa,#f472b6,#2dd4bf);
  -webkit-background-clip:text;background-clip:text;color:transparent}
.kicker{background:linear-gradient(90deg,#c4b5fd,#f472b6,#2dd4bf);
  -webkit-background-clip:text;background-clip:text;color:transparent;font-weight:600}
.hero h1{text-shadow:0 0 44px rgba(124,58,237,.35)}
.hero h1 .thin{color:var(--ink2)}
.post:hover{background:rgba(255,255,255,.045)}
.post .tag,.article .tag{background:rgba(167,139,250,.14);border-color:rgba(167,139,250,.35);color:#c4b5fd}
.post:hover h3{color:#c4b5fd}
.card{backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.card:hover{transform:translateY(-4px);border-color:rgba(167,139,250,.5);
  box-shadow:0 18px 44px rgba(124,58,237,.28),0 0 0 1px rgba(167,139,250,.25)}
.card .go{color:#c4b5fd}
.avatar{background:linear-gradient(135deg,#7c3aed,#db2777 55%,#0d9488);color:#fff;
  box-shadow:0 16px 44px rgba(219,39,119,.35)}
.about .links a{background:rgba(255,255,255,.05)}
.about .links a:hover{border-color:#a78bfa;color:#c4b5fd}
.article .body p{color:#ddd9f2}
.article .body code{background:rgba(255,255,255,.09)}
.article .body pre{border:1px solid rgba(255,255,255,.12)}
.chip{border-color:rgba(255,255,255,.22);color:var(--ink2);background:rgba(255,255,255,.03)}
.chip:hover{border-color:#a78bfa;color:#fff}
.chip.on{background:linear-gradient(120deg,#7c3aed,#db2777);border-color:transparent;color:#fff}
.pcard{background:rgba(255,255,255,.045);border-color:rgba(255,255,255,.12);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.pcard .pdesc{color:var(--muted)}
.pcard pre{background:rgba(0,0,0,.38);color:#e6e2ff}
.pcard .psrc{color:#6f6a94}
.copy-btn{border-color:rgba(255,255,255,.22);background:rgba(255,255,255,.05);color:var(--ink)}
.copy-btn:hover{background:linear-gradient(120deg,#7c3aed,#db2777);border-color:transparent;color:#fff}
@media (prefers-reduced-motion: reduce){
  body::before{animation:none}
  .reveal{transition:none}
}
/* ================= 手机端单独适配（≤640px，2026-10-23） ================= */
@media (max-width:640px){
  main{padding:0 18px}
  .nav-in{padding:0 16px;gap:14px;height:56px}
  .brand{font-size:17px;gap:5px}
  .nav-links{gap:13px;font-size:12.5px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
  .nav-links::-webkit-scrollbar{display:none}
  .nav-links a{white-space:nowrap}
  .hero{padding:104px 0 46px}
  .kicker{font-size:11px;letter-spacing:.16em;margin-bottom:16px}
  .hero h1{font-size:37px;line-height:1.22;margin-bottom:18px}
  .hero h1 .thin{font-size:.5em;margin-top:10px}
  .hero .sub{font-size:14.5px;line-height:1.8;margin-bottom:26px}
  .hero-meta{gap:8px 20px;font-size:12.5px}
  section{padding:44px 0}
  .sec-head{gap:10px;margin-bottom:26px}
  .sec-head h2{font-size:22px}
  .sec-head .en{letter-spacing:.18em;font-size:11px}
  .post{padding:20px 2px;gap:6px}
  .post h3{font-size:18.5px}
  .post p{font-size:13.5px}
  .cards{gap:12px}
  .card{padding:19px}
  .about{gap:22px}
  .avatar{width:120px;height:120px;font-size:40px;margin:0 auto}
  .article{padding:96px 0 60px}
  .article .body p{font-size:15.5px;line-height:1.95}
  .prompt-grid{grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr))}
  .pcard{padding:15px}
  footer{padding:30px 18px 44px;gap:8px 18px}
}
</style>
</head>
<body>
<div class="progress" id="progress"></div>
<nav id="topnav">
  <div class="nav-in">
    <a class="brand" href="#/">陈玉庆<span class="dot">.</span><span class="en">Chen Yuqing</span></a>
    <div class="nav-links">
      <a href="#/posts">文章</a>
      <a href="#/" data-nav="projects">项目</a>
