];

let curCat = "全部";
function renderPrompts(){
  const cats = ["全部", ...new Set(PROMPTS.map(p => p.cat))];
  $("#prompt-chips").innerHTML = cats.map(c =>
    `<button class="chip${c === curCat ? " on" : ""}" data-cat="${c}">${c}</button>`).join("");
  document.querySelectorAll("#prompt-chips .chip").forEach(b =>
    b.addEventListener("click", () => { curCat = b.dataset.cat; renderPrompts(); }));
  const esc = s => s.replace(/</g, "&lt;");
  $("#prompt-grid").innerHTML = PROMPTS.filter(p => curCat === "全部" || p.cat === curCat).map((p, i) => `
    <div class="pcard">
      <h3>${p.title}</h3>
      <p class="pdesc">${p.desc}</p>
      <pre>${esc(p.text)}</pre>
      <div class="prow"><span class="psrc">来源：${p.src}</span>
      <button class="copy-btn" data-copy="${PROMPTS.indexOf(p)}">复制</button></div>
    </div>`).join("");
  document.querySelectorAll(".copy-btn").forEach(b =>
    b.addEventListener("click", async () => {
      const t = PROMPTS[+b.dataset.copy].text;
      try { await navigator.clipboard.writeText(t); }
      catch (e) {
        const ta = document.createElement("textarea");
        ta.value = t; document.body.appendChild(ta); ta.select();
        document.execCommand("copy"); ta.remove();
      }
      b.textContent = "已复制 ✓"; setTimeout(() => b.textContent = "复制", 1500);
    }));
}

function fmtDate(d){ return d.replace(/-/g, "."); }

function renderList(){
  listEl.innerHTML = POSTS.map(p => `
    <a class="post reveal" href="#/post/${p.id}">
      <span class="date">${fmtDate(p.date)}</span>
      <span><span class="tag">${p.tag}</span>
        <h3>${p.title}</h3><p>${p.excerpt}</p></span>
      <span class="mins">${p.mins} 分钟</span>
    </a>`).join("");
}

function renderArticle(p){
  $("#art-tag").textContent = p.tag;
  $("#art-title").textContent = p.title;
  $("#art-meta").textContent = `${fmtDate(p.date)} · 阅读约 ${p.mins} 分钟 · 陈玉庆`;
  $("#art-body").innerHTML = p.body.map(b => {
    if (b.t === "h") return `<h4>${b.x}</h4>`;
    if (b.t === "code") return `<pre><code>${b.x.replace(/</g,"&lt;")}</code></pre>`;
    return `<p>${b.x}</p>`;
  }).join("");
}

function route(){
  const hash = location.hash || "#/";
  const m = hash.match(/^#\/post\/([\w-]+)$/);
  const post = m && POSTS.find(p => p.id === m[1]);
  if (hash === "#/prompts"){
    $("#home-view").hidden = true;
    $("#article-view").hidden = true;
    $("#prompts-view").hidden = false;
    document.title = "提示词库 · 陈玉庆";
    renderPrompts();
  } else if (post){
    renderArticle(post);
    $("#home-view").hidden = true;
    $("#prompts-view").hidden = true;
    $("#article-view").hidden = false;
    document.title = post.title + " · 陈玉庆";
  } else {
    $("#article-view").hidden = true;
    $("#prompts-view").hidden = true;
    $("#home-view").hidden = false;
    document.title = "陈玉庆 · 个人博客";
    if (!listEl.innerHTML) renderList();
    observeReveals();
  }
  window.scrollTo(0, 0);
  onScroll();
}

let observer;
function observeReveals(){
  if (observer) observer.disconnect();
  observer = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting){ e.target.classList.add("in"); observer.unobserve(e.target); }
  }), {threshold: .08});
  document.querySelectorAll(".reveal:not(.in)").forEach(el => observer.observe(el));
}

function onScroll(){
  $("#topnav").classList.toggle("scrolled", window.scrollY > 8);
  const inArticle = !$("#article-view").hidden;
  const bar = $("#progress");
  if (inArticle){
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + "%";
  } else bar.style.width = "0";
}
window.addEventListener("scroll", onScroll, {passive: true});

document.querySelectorAll("[data-nav]").forEach(a => {
  a.addEventListener("click", (e) => {
    const id = a.dataset.nav;
    if (!$("#article-view").hidden){ /* going home first */ }
    setTimeout(() => {
      const el = document.getElementById(id);
      if (el) el.scrollIntoView({behavior: "smooth"});
    }, 60);
  });
});

window.addEventListener("hashchange", route);
route();
</script>
