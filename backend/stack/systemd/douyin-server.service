[Unit]
Description=Douyin web backend (linux_server.py) on 7863
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/hatch
Environment=DOUYIN_DATA_DIR=/home/hatch/workspace/services/douyin-downloader/data
EnvironmentFile=-/etc/environment.d/80-hatch-egress.conf
ExecStart=/home/hatch/workspace/projects/douyin-direct-downloader/.venv/bin/python /home/hatch/workspace/projects/douyin-direct-downloader/linux_server.py --port 7863
WorkingDirectory=/home/hatch/workspace/projects/douyin-direct-downloader
Restart=always
RestartSec=5
StandardOutput=append:/home/hatch/workspace/services/douyin-downloader/logs/server.log
StandardError=append:/home/hatch/workspace/services/douyin-downloader/logs/server.log

[Install]
WantedBy=multi-user.target
