[Unit]
Description=Front proxy (proxy.py) on 7860 for tool.cyqing.icu stack
After=network-online.target douyin-server.service file-drop.service
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/hatch
EnvironmentFile=-/etc/environment.d/80-hatch-egress.conf
ExecStart=/usr/bin/python3 /home/hatch/workspace/services/douyin-downloader/proxy.py
WorkingDirectory=/home/hatch/workspace/services/douyin-downloader
Restart=always
RestartSec=5
StandardOutput=append:/home/hatch/workspace/services/douyin-downloader/logs/proxy.log
StandardError=append:/home/hatch/workspace/services/douyin-downloader/logs/proxy.log

[Install]
WantedBy=multi-user.target
