+// dialEdgeViaProxy performs one CONNECT + TLS handshake attempt.
+func dialEdgeViaProxy(
+	dialCtx context.Context,
+	proxyURL *url.URL,
+	edgeTCPAddr *net.TCPAddr,
+	tlsConfig *tls.Config,
+	timeout time.Duration,
+) (net.Conn, error) {
+	// Bound a single CONNECT attempt so a hung proxy egress leaves room
+	// for another attempt within the caller's overall dial context.
+	attemptCtx, cancel := context.WithTimeout(dialCtx, 12*time.Second)
+	defer cancel()
+	edgeConn, err := dialViaHTTPProxy(attemptCtx, proxyURL, connectTargetForEdge(edgeTCPAddr))
+	if err != nil {
+		return nil, err
+	}
+	return tlsHandshake(dialCtx, edgeConn, tlsConfig, timeout)
+}
 
