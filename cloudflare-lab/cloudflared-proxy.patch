+// connectTargetForEdge returns the CONNECT target for an edge address.
+// Measured on this egress proxy: CONNECT to a single edge IP succeeds
+// only ~25% of the time (the proxy gives up after ~10s with no fallback),
+// while CONNECT to the region hostname succeeds ~90% of the time because
+// the proxy can fall back across the region's addresses. The TLS layer
+// above is unaffected: it authenticates the edge by its certificate for
+// *.cftunnel.com, not by the CONNECT target.
+func connectTargetForEdge(edgeTCPAddr *net.TCPAddr) string {
+	if ip := edgeTCPAddr.IP; ip != nil {
+		if ip4 := ip.To4(); ip4 != nil {
+			switch {
+			case ip4[0] == 198 && ip4[1] == 41 && ip4[2] == 192:
+				return fmt.Sprintf("region1.v2.argotunnel.com:%d", edgeTCPAddr.Port)
+			case ip4[0] == 198 && ip4[1] == 41 && ip4[2] == 200:
+				return fmt.Sprintf("region2.v2.argotunnel.com:%d", edgeTCPAddr.Port)
+			}
+		} else {
+			switch ip.String() {
+			case "2606:4700:a0::1", "2606:4700:a0::2", "2606:4700:a0::3", "2606:4700:a0::4",
+				"2606:4700:a0::5", "2606:4700:a0::6", "2606:4700:a0::7", "2606:4700:a0::8",
+				"2606:4700:a0::9", "2606:4700:a0::10":
+				return fmt.Sprintf("region1.v2.argotunnel.com:%d", edgeTCPAddr.Port)
+			case "2606:4700:a8::1", "2606:4700:a8::2", "2606:4700:a8::3", "2606:4700:a8::4",
+				"2606:4700:a8::5", "2606:4700:a8::6", "2606:4700:a8::7", "2606:4700:a8::8",
+				"2606:4700:a8::9", "2606:4700:a8::10":
+				return fmt.Sprintf("region2.v2.argotunnel.com:%d", edgeTCPAddr.Port)
+			}
+		}
+	}
+	return edgeTCPAddr.String()
+}
