+// proxyURLFromEnv returns the HTTP proxy configured through the standard
+// proxy environment variables, or nil when no proxy is configured.
+// This environment's egress requires all outbound traffic to go through an
+// HTTP CONNECT proxy; stock cloudflared dials the edge directly and the
+// connection is intercepted, so DialEdge must tunnel through the proxy.
+func proxyURLFromEnv() *url.URL {
+	for _, key := range []string{"HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy"} {
+		value := os.Getenv(key)
+		if value == "" {
+			continue
+		}
+		proxyURL, err := url.Parse(value)
+		if err == nil && proxyURL.Host != "" {
+			return proxyURL
+		}
+	}
+	return nil
+}
+
+type bufferedConn struct {
+	net.Conn
+	reader *bufio.Reader
+}
+
+func (c *bufferedConn) Read(p []byte) (int, error) {
+	return c.reader.Read(p)
+}
+
+// dialViaHTTPProxy opens a TCP connection to target ("host:port") through an
+// HTTP CONNECT proxy and returns the established tunnel connection.
+func dialViaHTTPProxy(dialCtx context.Context, proxyURL *url.URL, target string) (net.Conn, error) {
+	dialer := net.Dialer{}
+	proxyConn, err := dialer.DialContext(dialCtx, "tcp", proxyURL.Host)
+	if err != nil {
+		return nil, errors.Wrap(err, "dial proxy")
+	}
+	if deadline, ok := dialCtx.Deadline(); ok {
+		if err := proxyConn.SetDeadline(deadline); err != nil {
+			_ = proxyConn.Close()
+			return nil, errors.Wrap(err, "set proxy deadline")
+		}
+	}
+	connectReq := fmt.Sprintf("CONNECT %s HTTP/1.1\r\nHost: %s\r\nProxy-Connection: keep-alive\r\n", target, target)
+	if proxyURL.User != nil {
+		username := proxyURL.User.Username()
+		password, _ := proxyURL.User.Password()
+		credentials := base64.StdEncoding.EncodeToString([]byte(username + ":" + password))
+		connectReq += "Proxy-Authorization: Basic " + credentials + "\r\n"
+	}
+	connectReq += "\r\n"
+	if _, err := proxyConn.Write([]byte(connectReq)); err != nil {
+		_ = proxyConn.Close()
+		return nil, errors.Wrap(err, "write CONNECT")
+	}
+	reader := bufio.NewReader(proxyConn)
+	resp, err := http.ReadResponse(reader, &http.Request{Method: http.MethodConnect})
+	if err != nil {
+		_ = proxyConn.Close()
+		return nil, errors.Wrap(err, "read CONNECT response")
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		_ = proxyConn.Close()
+		return nil, fmt.Errorf("proxy CONNECT %s failed: %s", target, resp.Status)
+	}
+	if err := proxyConn.SetDeadline(time.Time{}); err != nil {
+		_ = proxyConn.Close()
+		return nil, errors.Wrap(err, "clear proxy deadline")
+	}
+	if reader.Buffered() > 0 {
+		return &bufferedConn{Conn: proxyConn, reader: reader}, nil
+	}
+	return proxyConn, nil
+}
