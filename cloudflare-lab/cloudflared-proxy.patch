+// In this sandbox the system resolver refuses SRV queries and returns
+// fake-IP (198.18.0.0/15) answers for A queries, which makes stock edge
+// discovery unusable. When an HTTP proxy is configured (the only egress
+// path here), resolve edge records through DNS-over-HTTPS instead: the
+// HTTPS request itself goes through the proxy, which resolves real
+// addresses. The stock DoT fallback dials 1.1.1.1:853 directly and fails
+// for the same reason direct dials fail.
+func init() {
+	if os.Getenv("CLOUDFLARED_DISABLE_DOH") == "1" {
+		return
+	}
+	if os.Getenv("HTTPS_PROXY") == "" && os.Getenv("https_proxy") == "" &&
+		os.Getenv("HTTP_PROXY") == "" && os.Getenv("http_proxy") == "" {
+		return
+	}
+	netLookupSRV = lookupSRVWithDoH
+	netLookupIP = lookupIPWithDoH
+}
+
+type dohResponse struct {
+	Answer []struct {
+		Data string `json:"data"`
+		Type int    `json:"type"`
+	} `json:"Answer"`
+}
+
+func dohQuery(ctx context.Context, name string, recordType string) (*dohResponse, error) {
+	reqURL := "https://dns.google/resolve?name=" + name + "&type=" + recordType
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, reqURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("DoH query %s %s: %s", name, recordType, resp.Status)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return nil, err
+	}
+	var parsed dohResponse
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return nil, err
+	}
+	return &parsed, nil
+}
+
+func lookupSRVWithDoH(service string, proto string, name string) (string, []*net.SRV, error) {
+	queryName := "_" + service + "._" + proto + "." + name
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	result, err := dohQuery(ctx, queryName, "SRV")
+	if err != nil {
+		return "", nil, err
+	}
+	var records []*net.SRV
+	for _, answer := range result.Answer {
+		if answer.Type != 33 { // SRV
+			continue
+		}
+		fields := strings.Fields(answer.Data)
+		if len(fields) != 4 {
+			continue
+		}
+		priority, err := strconv.ParseUint(fields[0], 10, 16)
+		if err != nil {
+			continue
+		}
+		weight, err := strconv.ParseUint(fields[1], 10, 16)
+		if err != nil {
+			continue
+		}
+		port, err := strconv.ParseUint(fields[2], 10, 16)
+		if err != nil {
+			continue
+		}
+		records = append(records, &net.SRV{
+			Target:   fields[3],
+			Port:     uint16(port),
+			Priority: uint16(priority),
+			Weight:   uint16(weight),
+		})
+	}
+	if len(records) == 0 {
+		return "", nil, fmt.Errorf("DoH SRV query for %s returned no records", queryName)
+	}
+	return "", records, nil
+}
+
+func lookupIPWithDoH(host string) ([]net.IP, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	result, err := dohQuery(ctx, host, "A")
+	if err != nil {
+		return nil, err
+	}
+	var ips []net.IP
+	for _, answer := range result.Answer {
+		if answer.Type != 1 { // A
+			continue
+		}
+		if ip := net.ParseIP(answer.Data); ip != nil {
+			ips = append(ips, ip)
+		}
+	}
+	if len(ips) == 0 {
+		return nil, fmt.Errorf("DoH A query for %s returned no addresses", host)
+	}
+	return ips, nil
+}
+
