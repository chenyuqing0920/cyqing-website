[Unit]
Description=WeChat task bridge (iLink Bot serve: receive tasks, send replies)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=/home/hatch
EnvironmentFile=-/etc/environment.d/80-hatch-egress.conf
ExecStart=/home/hatch/workspace/wechat-bridge/.venv/bin/python bridge.py serve
WorkingDirectory=/home/hatch/workspace/wechat-bridge
Restart=always
RestartSec=5
StandardOutput=append:/home/hatch/workspace/wechat-bridge/logs/serve.out
StandardError=append:/home/hatch/workspace/wechat-bridge/logs/serve.out

[Install]
WantedBy=multi-user.target
